# Copia este archivo a ".env" y ajusta los valores según tu entorno.

DEBUG=false
HOST=0.0.0.0
PORT=8000

# Ruta al credentials.json de la cuenta de servicio de Google
GOOGLE_CREDENTIALS_PATH=assets/keys/credentials.json

# Mismo Spreadsheet y carpeta de Drive que usaba la app Flutter
SPREADSHEET_ID=1xRbkZtuUQooJYiztslEkfpm1MKw2FzCpXkD0WMY5jIA
DATOS_RANGE=DATOS!A2:H
PERSONAL_RANGE=PERSONAL!A2:E
DRIVE_FOLDER_ID=1ZzvJhQlnRwsbyTKCru0KatqpKN1gLJBd

# Reconocimiento facial: distancia euclidiana máxima entre encodings (128-d)
# para aceptar una coincidencia. Más bajo = más estricto / más preciso.
FACE_MATCH_TOLERANCE=0.45
FACE_DETECTION_MODEL=hog
FACE_UPSAMPLE_TIMES=1
FACE_JITTER=3

# Caché de encodings de referencia (segundos antes de refrescar desde Drive)
CACHE_TTL_SECONDS=3600
